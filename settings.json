{
  "permissions": {
    "defaultMode": "plan"
  },
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/Users/adamfilchoir/.caveman/bin/caveman-proxy' native-hook claude --adapter '/opt/homebrew/lib/node_modules/@caveman-ai/cli/dist/native-hook-fast.js' --node '/opt/homebrew/bin/node'",
            "timeout": 30
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/opt/homebrew/bin/node' '/opt/homebrew/bin/caveman' shrink-hook",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/adamfilchoir/.local/share/caveman-blocks/bin/caveman-blocks hook --harness claude",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/Users/adamfilchoir/.caveman/bin/caveman-proxy' native-hook claude --adapter '/opt/homebrew/lib/node_modules/@caveman-ai/cli/dist/native-hook-fast.js' --node '/opt/homebrew/bin/node'",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/Users/adamfilchoir/.caveman/bin/caveman-proxy' native-hook claude --adapter '/opt/homebrew/lib/node_modules/@caveman-ai/cli/dist/native-hook-fast.js' --node '/opt/homebrew/bin/node'",
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/Users/adamfilchoir/.caveman/bin/caveman-proxy' native-hook claude --adapter '/opt/homebrew/lib/node_modules/@caveman-ai/cli/dist/native-hook-fast.js' --node '/opt/homebrew/bin/node'",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/Users/adamfilchoir/.caveman/bin/caveman-proxy' native-hook claude --adapter '/opt/homebrew/lib/node_modules/@caveman-ai/cli/dist/native-hook-fast.js' --node '/opt/homebrew/bin/node'",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/Users/adamfilchoir/.caveman/bin/caveman-proxy' native-hook claude --adapter '/opt/homebrew/lib/node_modules/@caveman-ai/cli/dist/native-hook-fast.js' --node '/opt/homebrew/bin/node'",
            "timeout": 30
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/Users/adamfilchoir/.caveman/bin/caveman-proxy' native-hook claude --adapter '/opt/homebrew/lib/node_modules/@caveman-ai/cli/dist/native-hook-fast.js' --node '/opt/homebrew/bin/node'",
            "timeout": 30
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/Users/adamfilchoir/.caveman/bin/caveman-proxy' native-hook claude --adapter '/opt/homebrew/lib/node_modules/@caveman-ai/cli/dist/native-hook-fast.js' --node '/opt/homebrew/bin/node'",
            "timeout": 30
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/Users/adamfilchoir/.caveman/bin/caveman-proxy' native-hook claude --adapter '/opt/homebrew/lib/node_modules/@caveman-ai/cli/dist/native-hook-fast.js' --node '/opt/homebrew/bin/node'",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/Users/adamfilchoir/.caveman/bin/caveman-proxy' native-hook claude --adapter '/opt/homebrew/lib/node_modules/@caveman-ai/cli/dist/native-hook-fast.js' --node '/opt/homebrew/bin/node'",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "mattpocock-skills@claude-plugins-official": true,
    "ponytail@ponytail": true,
    "taste-skill@taste-skill": true,
    "swift-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    },
    "taste-skill": {
      "source": {
        "source": "github",
        "repo": "Leonxlnx/taste-skill"
      }
    }
  },
  "outputStyle": "Explanatory",
  "theme": "dark",
  "env": {
    "ANTHROPIC_BASE_URL": "http://127.0.0.1:8787/w/claude",
    "_CLAUDE_CODE_ASSUME_FIRST_PARTY_BASE_URL": "1",
    "ENABLE_TOOL_SEARCH": "auto",
    "ANTHROPIC_CUSTOM_MODEL_OPTION": "caveman-auto[1m]",
    "ANTHROPIC_CUSTOM_MODEL_OPTION_NAME": "Auto",
    "ANTHROPIC_CUSTOM_MODEL_OPTION_DESCRIPTION": "Caveman pick model + effort each turn. Hard ask, big brain. Easy ask, save rocks.",
    "ANTHROPIC_CUSTOM_MODEL_OPTION_SUPPORTED_CAPABILITIES": "effort,max_effort,xhigh_effort,thinking,adaptive_thinking,interleaved_thinking"
  }
}
